{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wakeword-downsampling.schema.json",
  "title": "Fig. 01b — downsampling comparison",
  "description": "One real 'Go Gators' recording at its native 48 kHz and downsampled to 16 kHz (the Speech Commands pretraining rate), plus the real sample-rate experiment results. Exported by ml/wakeword/export_wakeword.py.",
  "type": "object",
  "required": ["clipId", "original", "downsampled", "experiments"],
  "properties": {
    "$schema": { "type": "string" },
    "clipId": { "type": "string", "description": "Id of the clip in wakeword-clips.json" },
    "note": { "type": "string" },
    "original": { "$ref": "#/$defs/signal" },
    "downsampled": { "$ref": "#/$defs/signal" },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["approach", "outcome"],
        "properties": {
          "approach": { "type": "string" },
          "valF1": { "type": "number" },
          "testF1": { "type": "number" },
          "accuracy": { "type": "number" },
          "f1": { "type": "number" },
          "approx": { "type": "boolean", "description": "True when the number is approximate (read off training curves)" },
          "outcome": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "signal": {
      "type": "object",
      "required": ["sampleRate", "nyquistHz", "waveform", "spectrum"],
      "properties": {
        "sampleRate": { "type": "integer" },
        "nyquistHz": { "type": "integer" },
        "waveform": {
          "type": "array",
          "description": "Peak-envelope of the recording, -1..1",
          "items": { "type": "number", "minimum": -1, "maximum": 1 }
        },
        "spectrum": {
          "type": "array",
          "description": "Log-magnitude spectrum normalized 0..1, bins spanning 0..nyquistHz",
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "spectrumDbRange": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
