{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bioclock.schema.json",
  "title": "BioClock classifier demo",
  "description": "Precomputed classifier outputs sampled along a restlessness axis. The exhibit interpolates between samples as the visitor drags the slider. Replace with real on-device classifier outputs over recorded sensor windows.",
  "type": "object",
  "required": ["states", "samples"],
  "properties": {
    "device": { "type": "string" },
    "classifier": { "type": "string" },
    "states": { "type": "array", "items": { "type": "string" } },
    "samples": {
      "type": "array",
      "description": "Ordered by restlessness ascending; should span 0..1",
      "items": {
        "type": "object",
        "required": ["restlessness", "state", "confidence", "hr", "accel"],
        "properties": {
          "restlessness": { "type": "number", "minimum": 0, "maximum": 1 },
          "state": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "hr": { "type": "array", "description": "Heart-rate trace, bpm", "items": { "type": "number" } },
          "accel": { "type": "array", "description": "Accelerometer magnitude trace, g", "items": { "type": "number" } }
        }
      }
    }
  }
}
