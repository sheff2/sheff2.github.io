{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wakeword-clips.schema.json",
  "title": "Wake-word detector demo clips",
  "description": "Real model outputs for the wake-word exhibit, exported by ml/wakeword/export_wakeword.py: one entry per audio clip from the EEE4773 training recordings, the mel spectrogram exactly as the network saw it, and the sigmoid detection score from the trained transfer-learned CNN (scored batch-1, matching browser inference).",
  "type": "object",
  "required": ["threshold", "sampleRate", "clips"],
  "properties": {
    "$schema": { "type": "string" },
    "model": { "type": "string", "description": "Human-readable model identifier" },
    "wakeWord": { "type": "string" },
    "threshold": { "type": "number", "description": "Detection threshold on the sigmoid score (score above threshold = wake word)" },
    "thresholdRule": { "type": "string" },
    "sampleRate": { "type": "integer", "const": 16000 },
    "nMels": { "type": "integer" },
    "hopMs": { "type": "number" },
    "fftLength": { "type": "integer" },
    "metrics": {
      "type": "object",
      "description": "Real evaluation numbers for the trained model",
      "properties": {
        "trainAccuracy": { "type": "number" },
        "trainF1": { "type": "number" },
        "heldOutTestF1": { "type": "number" },
        "confusion": {
          "type": "object",
          "required": ["tn", "fp", "fn", "tp"],
          "properties": {
            "tn": { "type": "integer" },
            "fp": { "type": "integer" },
            "fn": { "type": "integer" },
            "tp": { "type": "integer" }
          }
        }
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "category", "score", "detected", "durationSec", "audioUrl", "melSpectrogram", "waveform"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "category": { "enum": ["wake", "speech", "noise"] },
          "sourceIndex": { "type": "integer", "description": "Index of the clip in the original training npy" },
          "trueLabel": { "type": "integer", "enum": [0, 1] },
          "score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Sigmoid output of the trained network for this clip" },
          "detected": { "type": "boolean" },
          "durationSec": { "type": "number" },
          "audioUrl": { "type": "string" },
          "melSpectrogram": {
            "type": "array",
            "description": "frames × nMels, normalized 0..1 for display (raw dB range in melDbRange)",
            "items": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } }
          },
          "melDbRange": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "waveform": { "type": "array", "items": { "type": "number", "minimum": -1, "maximum": 1 } }
        }
      }
    }
  }
}
