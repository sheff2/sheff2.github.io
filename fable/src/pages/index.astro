import Hero from '../components/Hero.astro';
import Divider from '../components/Divider.astro';
import Project from '../components/Project.astro';
import PaperCard from '../components/PaperCard.astro';
import Wakeword from '../components/exhibits/Wakeword.astro';
import Downsampling from '../components/exhibits/Downsampling.astro';
import GlassesDemo from '../components/exhibits/GlassesDemo.astro';
import Bioclock from '../components/exhibits/Bioclock.astro';
import MentorMatch from '../components/exhibits/MentorMatch.astro';
import TaxiTips from '../components/exhibits/TaxiTips.astro';

const bibtex = `@techreport{burchill2026wakeword,
  title     = {Wake Word Detection via Transfer Learning},
  author    = {Burchill, Landon and Heffernan, Shaun and Gelli, Yuri},
  institution = {University of Florida},
  year      = {2026},
  type      = {EEE4773 Final Project Report}
}`;

const taxiBibtex = `@techreport{heffernan2026taxi,
  title     = {Predicting NYC Taxi Tips using Machine Learning},
  author    = {Heffernan, Shaun},
  institution = {University of Florida},
  year      = {2026},
  type      = {Course Project Report}
}`;

const xrayBibtex = `@techreport{heffernan2026xray,
  title     = {Classifying Diseases from Chest X-Ray Scans using Convolutional Neural Networks},
  author    = {Heffernan, Shaun},
  institution = {University of Florida},
  year      = {2026},
  type      = {Course Project Report}
}`;

// seeded mini-heatmap for the Appendix B card (echoes the divider heatmap)
function appxRng(seed: number) {
  return () => {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const xr = appxRng(14);
const xrayCells: { x: number; y: number; o: number; hot: boolean }[] = [];
for (let row = 0; row < 4; row++) {
  for (let col = 0; col < 28; col++) {
    const v = xr();
    xrayCells.push({ x: col * 10, y: row * 10, o: 0.12 + v * 0.5, hot: v > 0.93 });
  }
}

const shipsBibtex = `@techreport{heffernan2026ships,
  title     = {Satellite Image Classification with Dimensionality Reduction: Detecting Cargo Ships},
  author    = {Heffernan, Shaun},
  institution = {University of Florida},
  year      = {2026},
  type      = {Signal Processing Course Project}
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shaun Heffernan · Software Engineer · ML · Full-Stack · Real-Time</title>
    <meta
      name="description"
      content="Shaun Heffernan is a computer science student at the University of Florida who builds software that ships: machine learning systems, real-time pipelines, and full-stack apps."
    />
