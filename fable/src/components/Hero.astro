---
// Hero signal: generated at build time, drawn at load by GSAP.
const W = 1200;
const H = 120;
const mid = H / 2;

function rng(seed: number) {
  return () => {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = rng(2028);
let d = `M 0 ${mid}`;
const peaks: number[] = [];
for (let x = 6; x <= W; x += 6) {
  // three syllable-like energy bursts — the spoken name as a signal
  const env =
    0.9 * Math.exp(-(((x - W * 0.22) / 70) ** 2)) +
    1.0 * Math.exp(-(((x - W * 0.52) / 95) ** 2)) +
    0.75 * Math.exp(-(((x - W * 0.8) / 60) ** 2));
  const y = mid + ((r() - 0.5) * 100 + Math.sin(x * 0.09) * 16) * Math.min(1, env);
  peaks.push(y);
  d += ` L ${x} ${Math.round(y * 10) / 10}`;
}

const first = 'SHAUN';
const last = 'HEFFERNAN';
---

<header class="hero wrap" id="top">
  <div class="hero__kicker mono" data-hero-kicker>
    <span><strong>Shaun Heffernan</strong> · calibration sheet, rev. 2026</span>
    <span>input: ideas · output: software</span>
  </div>

  <svg
    class="hero__signal"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    aria-hidden="true"
    data-hero-signal
  >
    <path class="signal-path" d={d} data-signal-path />
    <circle class="signal-impulse" cx={W * 0.52} cy={mid} r="4" data-signal-impulse />
  </svg>

  <h1 class="hero__name display" data-hero-name>
    <span class="sr-only">Shaun Heffernan</span>
    <span aria-hidden="true" class="line">
      {first.split('').map((c) => <span class="char">{c}</span>)}
    </span>
    <span aria-hidden="true" class="line last">
      {last.split('').map((c) => <span class="char">{c}</span>)}
    </span>
  </h1>

  <p class="hero__id" data-hero-id>
    I'm a computer science student at the University of Florida building
    <em>software that ships</em>: machine learning systems, real-time
    pipelines, and full-stack apps.
  </p>

  <nav class="hero__links" aria-label="Contact links" data-hero-links>
    <a class="u-link" href="https://github.com/sheff2">GitHub</a>
    <a class="u-link" href="https://linkedin.com/in/shaunheff">LinkedIn</a>
    <a class="u-link" href="mailto:heffernanshaun2@gmail.com">Email</a>
  </nav>

  <p class="hero__scroll mono" data-hero-scroll aria-hidden="true">scroll · signal path begins ↓</p>
</header>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .line { display: block; }
</style>
