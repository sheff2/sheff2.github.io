    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.65rem 0.85rem;
    margin: 0 0 0.9rem;
    border-color: var(--c-red);
    color: var(--c-red);
  }
  .ww-record:hover:not(:disabled) {
    background: var(--c-red);
    border-color: var(--c-red);
    color: var(--c-bg);
  }
  .ww-record__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ww-record:not(:disabled) .ww-record__dot { animation: ww-rec-pulse 1.6s ease-in-out infinite; }
  }
  @keyframes ww-rec-pulse {
    50% { opacity: 0.25; }
  }
  @media (max-width: 420px) {
    .ww-clips { grid-template-columns: 1fr; }
  }
</style>
